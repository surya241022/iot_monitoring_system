# ============================================
# Factory Telemetry & S3 Collector Configuration
# Copy this file to .env and update values
# ============================================

# Telemetry Generator Settings
FACTORY_ID=FACTORY_001
MACHINE_IDS=MACHINE_001,MACHINE_002,MACHINE_003,MACHINE_004,MACHINE_005
GENERATION_INTERVAL_SECONDS=5
HISTORY_MAX_RECORDS=500

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Collector Settings
COLLECTOR_INTERVAL_SECONDS=5
LOCAL_DRY_RUN=true
LOCAL_S3_OUTPUT_DIR=./local_s3_output

# AWS Configuration
# NOTE: On AWS ECS, prefer attaching an IAM Task Role instead of static access keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Amazon S3 Settings
S3_BUCKET_NAME=your-factory-telemetry-bucket
S3_PREFIX=telemetry/raw

# AWS ECS Settings
ECS_CLUSTER_NAME=factory-telemetry-cluster
ECS_API_SERVICE_NAME=telemetry-api-service
ECS_COLLECTOR_SERVICE_NAME=telemetry-collector-service
